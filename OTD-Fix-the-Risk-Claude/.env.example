# OTD — Fix the Risk (Claude-backed) — environment template
# Copy to `.env` and fill in. NEVER commit a filled-in .env. Secrets live here
# only, never in code or markdown.

# ─────────────────────────────────────────────────────────────────────────────
# LLM routing — Anthropic API direct (replaces SAP AI Core / Gen AI Hub)
# ─────────────────────────────────────────────────────────────────────────────
# Required for the agent's reasoning + summarization steps. Get a key at
# https://console.anthropic.com/. Billed by Anthropic (running off SAP AI Core
# is a governance deviation — see agent-outcome-report.md).
ANTHROPIC_API_KEY=

# Optional model overrides. Defaults preserve the tier the SAP build was
# validated on (Claude Sonnet / Haiku). Use LiteLLM's `anthropic/` provider ids.
# Upgrade path: anthropic/claude-sonnet-5, anthropic/claude-opus-5.
# OTD_MODEL=anthropic/claude-sonnet-4-5
# OTD_SUMMARIZATION_MODEL=anthropic/claude-haiku-4-5

# ─────────────────────────────────────────────────────────────────────────────
# Run mode
# ─────────────────────────────────────────────────────────────────────────────
# IBD_TESTING=1 → offline mock tools from mcp-mock.json (no SAP, no credentials).
# Unset/0       → live OData bridge (requires the OTD_SERVICE_* config below).
IBD_TESTING=1

# A2A server bind + the public URL advertised in the agent card (used by Joule
# for discovery). For local runs the default http://HOST:PORT/ is fine.
HOST=0.0.0.0
PORT=5000
# AGENT_PUBLIC_URL=https://otd-agent.example.com/

# ─────────────────────────────────────────────────────────────────────────────
# Prompt-injection detector (scans tool results)
# ─────────────────────────────────────────────────────────────────────────────
# PROMPT_INJECTION_DETECTION=true
# PROMPT_INJECTION_MODE=block          # block | log
# PROMPT_INJECTION_LLM_ENABLED=false
# PROMPT_INJECTION_LLM_MODEL=anthropic/claude-haiku-4-5

# ─────────────────────────────────────────────────────────────────────────────
# LIVE tools — read-only OData→MCP bridge (only used when IBD_TESTING is unset)
# ─────────────────────────────────────────────────────────────────────────────
# JSON map from translation ordId (or mcp-server folder name) → OData service
# base URL on YOUR tenant. All 5 keys the agent needs are pre-filled below;
# replace each https://<s4-host>/... with the real service base URL from your
# S/4HANA service catalog, then put it on ONE line as OTD_SERVICE_BASE_URLS=...
# OTD_SERVICE_BASE_URLS={
#   "sap.s4:apiResource:CE_SALESORDER_0001:v1":            "https://<s4-host>/sap/opu/odata4/sap/api_salesorder/srvd_a2x/sap/salesorder/0001",
#   "sap.s4:apiResource:WAREHOUSEAVAILABLESTOCK_0001:v1":  "https://<s4-host>/sap/opu/odata4/sap/api_warehouse_available_stock/srvd_a2x/sap/warehouseavailablestock/0001",
#   "sap.s4:apiResource:API_PRODUCTION_ORDER_2_SRV:v1":    "https://<s4-host>/sap/opu/odata/sap/API_PRODUCTION_ORDER_2_SRV",
#   "sap.s4:apiResource:API_OUTBOUND_DELIVERY_SRV_0002:v2":"https://<s4-host>/sap/opu/odata/sap/API_OUTBOUND_DELIVERY_SRV;v=0002",
#   "sap.s4:apiResource:CE_FREIGHTORDER_0001:v1":          "https://<s4-host>/sap/opu/odata4/sap/api_freightorder/srvd_a2x/sap/freightorder/0001"
# }
# OTD_SERVICE_BASE_URLS=

# Directory holding the sap-s4-*-mcp-server folders (defaults to the assets/
# directory that contains this agent folder).
# OTD_MCP_TRANSLATION_ROOT=
# OTD_HTTP_TIMEOUT_SECONDS=30

# ─────────────────────────────────────────────────────────────────────────────
# LIVE identity propagation — token exchange (only used when IBD_TESTING is unset)
# ─────────────────────────────────────────────────────────────────────────────
# basic       → fixed technical user (OTD_S4_USER + OTD_S4_PASSWORD), e.g. an
#               S/4HANA Cloud communication user. No SAML / destination service.
#               Simplest path to a live test; every call acts as this one identity
#               (no per-user RBAC). Read-only still holds. ← default below.
# passthrough → forward the caller's A2A bearer unchanged (same IdP as S/4).
# xsuaa       → OAuth2 jwt-bearer grant against XSUAA (true principal propagation).
# destination → resolve a BTP Destination (OAuth2SAMLBearer / PrincipalPropagation).
OTD_TOKEN_EXCHANGE_MODE=basic

# Required when OTD_TOKEN_EXCHANGE_MODE=basic — a communication user assigned (via a
# Communication Arrangement) to the inbound OData services above. Secrets — .env only.
OTD_S4_USER=
OTD_S4_PASSWORD=

# Required when OTD_TOKEN_EXCHANGE_MODE=xsuaa
# XSUAA_TOKEN_URL=
# XSUAA_CLIENT_ID=
# XSUAA_CLIENT_SECRET=

# Required when OTD_TOKEN_EXCHANGE_MODE=destination
# BTP_DESTINATION_URL=      # Destination service base (…/destination-configuration/v1)
# BTP_DESTINATION_NAME=     # the Destination name that points at your S/4 system
# BTP_DESTINATION_TOKEN=    # OAuth token for the Destination service (secret — fill in .env only)

# ─────────────────────────────────────────────────────────────────────────────
# Demo UI (demo/serve_demo.py) — local demonstration only
# ─────────────────────────────────────────────────────────────────────────────
# OTD_AGENT_URL=http://localhost:5000/
# DEMO_PORT=8000
